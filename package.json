{
  "name": "awo",
  "version": "0.0.1",
  "description": "Scaffolds and orchestrates AI-agent development workspaces.",
  "type": "module",
  "bin": {
    "awo": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "scripts"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run build && npm run build:test",
    "test": "node --test dist/test/**/*.test.js",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/verify-template.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "orchestration",
    "cli",
    "scaffolding"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "simple-git": "^3.27.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.5.0",
    "typescript": "^5.6.0"
  }
}
