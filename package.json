{
  "name": "@supanut9/awo",
  "version": "0.0.39",
  "description": "Scaffolds and orchestrates AI-agent development workspaces.",
  "type": "module",
  "bin": {
    "awo": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supanut9/awo.git"
  },
  "bugs": {
    "url": "https://github.com/supanut9/awo/issues"
  },
  "homepage": "https://github.com/supanut9/awo#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "build:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run build && npm run build:test",
    "test": "node --test dist/test/**/*.test.js",
    "prepublishOnly": "npm run build && npm test && node scripts/verify-template.mjs",
    "build:ui": "vite build",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "dev:ui": "vite"
  },
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "orchestration",
    "cli",
    "scaffolding"
  ],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "gray-matter": "^4.0.3",
    "mongodb": "^7.5.0",
    "simple-git": "^3.27.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.5.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "marked": "^18.0.7",
    "preact": "^10.29.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8.1.5"
  }
}
