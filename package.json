{
  "name": "@supanut9/awo",
  "version": "0.8.0",
  "description": "Scaffolds and orchestrates AI-agent development workspaces.",
  "type": "module",
  "bin": {
    "awo": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supanut9/awo.git"
  },
  "bugs": {
    "url": "https://github.com/supanut9/awo/issues"
  },
  "homepage": "https://github.com/supanut9/awo#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "templates",
    "GUIDE.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\" && node scripts/write-build-info.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "pretest": "npm run build && npm run build:test",
    "test": "AWO_HUMAN=1 node --test dist/test/**/*.test.js",
    "prepublishOnly": "npm run build && npm test && node scripts/verify-template.mjs",
    "build:ui": "vite build",
    "typecheck:ui": "tsc -p tsconfig.ui.json",
    "dev:ui": "vite",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "workflow",
    "orchestration",
    "cli",
    "scaffolding"
  ],
  "license": "MIT",
  "dependencies": {
    "chokidar": "^5.0.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.4.1",
    "gray-matter": "^4.0.3",
    "mongodb": "^7.9.1",
    "simple-git": "^4.1.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "marked": "^18.2.1",
    "preact": "^10.29.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
