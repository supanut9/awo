# Linked working repos — reconstructed from .workspace/manifest.json
/repos/

# Generated VS Code multi-root workspace file — derived from the manifest,
# regenerated by add/connect/remove, never hand-edited
/*.code-workspace

# Runtime: run logs and task state (machine-specific)
/logs/
**/state.json

# Connector credentials / secrets — never commit the contents,
# but keep the folder + its README so the "no config in ~" rule is documented
/.workspace/credentials/*
!/.workspace/credentials/README.md
.env
.env.*

# Node
node_modules/

# Upgrade backups — copies of scaffolding replaced by `awo upgrade` (§11.4)
/.workspace/upgrade-backups/
